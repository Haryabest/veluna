# =============================================================================
# Veluna Frontend — local environment
# =============================================================================

# Single-tunnel mode (Pinggy): leave API empty — Next.js proxies /api/v1 -> backend :8000
# Run: ..\scripts\dev-miniapp-up.ps1  (updates automatically)

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=

NEXT_PUBLIC_APP_NAME=Veluna
# 8000 = uvicorn on host (.\scripts\run-backend-local.ps1)
# 8020 = Docker backend (docker compose up -d backend)
BACKEND_PORT=8000
