# =============================================================================
# Veluna — Environment Configuration
# Copy to .env and fill in values
# =============================================================================

# --- App ---
APP_NAME=Veluna
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
API_V1_PREFIX=/api/v1

# --- Docker deploy (docker-compose.deploy.yml) ---
VELUNA_HTTP_PORT=80

# --- Frontend ---
# Local dev: leave empty — Next.js proxies /api/v1 → backend (see frontend/.env.local.example)
# Tunnel/Mini App: set to backend tunnel URL (veluna-dev-up.ps1 does this automatically)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
NEXT_PUBLIC_APP_NAME=Veluna
BACKEND_PORT=8000

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# --- Database ---
POSTGRES_USER=veluna
POSTGRES_PASSWORD=veluna_secret
POSTGRES_DB=veluna
# Docker: @postgres:5432  |  Local dev: @127.0.0.1:5432  (setup-env.ps1 patches this)
DATABASE_URL=postgresql+asyncpg://veluna:veluna_secret@postgres:5432/veluna

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-key-dev-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Telegram ---
# Bot: /start opens Mini App. Web App URL must be HTTPS in production.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBAPP_URL=https://your-domain.com

# --- Dev tunnel (Pinggy — recommended for Mini App) ---
# Run: .\scripts\dev-miniapp-up.ps1
# NGROK_AUTHTOKEN=

# --- AI Providers (chat) ---
# GenAPI: https://gen-api.ru/model/gpt-4o-mini/api
AI_CHAT_PROVIDER=genapi
GEN_API_KEY=sk-4zlTDkd8seIXE7ALYCKarL7uTJujXbRliFASJeFCQ415wbCuybMCsgg7ani0
GEN_API_MODEL=gpt-4o-mini
GEN_API_BASE_URL=https://proxy.gen-api.ru/v1
GEN_API_INPUT_RUB_PER_1K_TOKENS=0.05
GEN_API_OUTPUT_RUB_PER_1K_TOKENS=0.15

# --- Image Generation ---
IMAGE_PROVIDER=civitai
CIVITAI_API_KEY=129ccf34b66c8036e53c7494c58a975e

# --- Storage ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=veluna_minio
MINIO_SECRET_KEY=veluna_minio_secret
MINIO_BUCKET=veluna
MINIO_USE_SSL=false
# Use /media — proxied by Next.js (works on phone via Pinggy). Local dev: http://localhost:9000/veluna
MINIO_PUBLIC_URL=/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=veluna

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Chat cache (Redis DB 1) ---
CHAT_CACHE_LIST_TTL=120
CHAT_CACHE_DETAIL_TTL=30
CHAT_CACHE_MESSAGES_TTL=120

# --- Pricing (Gems) ---
GEM_COST_PER_MESSAGE=1
GEM_COST_PER_GENERATION=10
DEFAULT_USER_GEMS=50

# --- Admin ---
ADMIN_TELEGRAM_IDS=
ADMIN_TELEGRAM_USERNAMES=Iabobuss

# =============================================================================
# Production checklist (docker-compose.deploy.yml)
# =============================================================================
# 1. APP_ENV=production  DEBUG=false
# 2. Generate strong SECRET_KEY and JWT_SECRET_KEY (32+ chars)
# 3. Set TELEGRAM_WEBAPP_URL=https://your-domain.com
# 4. Set CORS_ORIGINS=https://your-domain.com
# 5. NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws
# 6. Point domain A-record to server IP, enable HTTPS (certbot + nginx)
# 7. Run: docker compose -f docker-compose.deploy.yml up -d --build
# 8. Bot: run on host if Docker networking blocks Telegram API
#    Linux: docker compose ... + bot in container usually works
#    Windows: .\scripts\run-bot-local.ps1
