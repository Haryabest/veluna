# =============================================================================
# Veluna — Environment Configuration
# Copy to .env and fill in values
# =============================================================================

# --- App ---
APP_NAME=Veluna
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
API_V1_PREFIX=/api/v1

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=Veluna

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# --- Database ---
POSTGRES_USER=veluna
POSTGRES_PASSWORD=veluna_secret
POSTGRES_DB=veluna
DATABASE_URL=postgresql+asyncpg://veluna:veluna_secret@postgres:5432/veluna

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBAPP_URL=https://your-domain.com

# --- AI Providers ---
AI_CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Image Generation ---
IMAGE_PROVIDER=fal
FAL_API_KEY=
REPLICATE_API_TOKEN=

# --- Storage ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=veluna_minio
MINIO_SECRET_KEY=veluna_minio_secret
MINIO_BUCKET=veluna
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/veluna
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=veluna

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Pricing (Gems) ---
GEM_COST_PER_MESSAGE=1
GEM_COST_PER_GENERATION=10
DEFAULT_USER_GEMS=50

# --- Admin ---
ADMIN_TELEGRAM_IDS=123456789
